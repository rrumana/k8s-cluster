{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "commitHourlyLimit": 0,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "rangeStrategy": "pin",
  "ignorePaths": [
    "snapshots/**",
    "cluster/platform/base/data/data-operators/postgres-operator/cnpg-*.yaml",
    "cluster/platform/base/data/data-definitions/valkey/queue/storage-migration-copy-job.yaml",
    "cluster/platform/registry/harbor/vendor/**"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/cluster/platform/gitops/argocd/apps/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/cluster/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track explicitly annotated version values outside supported managers",
      "managerFilePatterns": [
        "/(^|/).+\\.(?:ya?ml|sh|md)$/",
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?\\s+(?:[A-Za-z0-9_.-]+:\\s*[\\\"']?|[A-Za-z0-9_]+=[\\\"']?)(?<currentValue>v?[0-9][A-Za-z0-9._+-]*)(?:[\\\"']|\\s|$)",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+-\\s+https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?<currentValue>v?[0-9][A-Za-z0-9._+-]*)/[^\\s]+"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track upstream images hardcoded in the observability seeding script",
      "managerFilePatterns": [
        "/^scripts/seed-observability-prereqs\\.sh$/"
      ],
      "matchStrings": [
        "[\\\"](?<depName>(?:docker\\.io|quay\\.io|ghcr\\.io|registry\\.k8s\\.io|cr\\.fluentbit\\.io)/[^:\\\"@]+):(?<currentValue>[^\\\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\\\"]"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Keep the kubectl helper aligned with the Kubernetes bootstrap version",
      "managerFilePatterns": [
        "/^cluster/platform/base/networking/egress-qos/configmap\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+: \\\"\\$\\{KUBECTL_VERSION:=(?<currentValue>v[0-9.]+)\\}\\\""
      ]
    },
    {
      "customType": "regex",
      "description": "Track PostgreSQL images in CloudNativePG Cluster resources",
      "managerFilePatterns": [
        "/^cluster/platform/base/data/data-definitions/postgres/[^/]+/cluster\\.yaml$/"
      ],
      "matchStrings": [
        "imageName:\\s*[\\\"']?(?<depName>[^\\s\\\"'@:]+(?:/[^\\s\\\"'@:]+)+):(?<currentValue>[^\\s\\\"'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\\\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Disable Harbor-only OCI chart lookups; annotated custom managers use the true upstream source",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.rcrumana.xyz/thirdparty-charts/**"],
      "enabled": false
    },
    {
      "description": "Do not update private image tags by querying Harbor",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.rcrumana.xyz/apps-private/**"],
      "enabled": false
    },
    {
      "description": "Track custom compatibility builds only through the manual dependency manifest",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "harbor.rcrumana.xyz/mirror/lemker/unifi-os-server",
        "harbor.rcrumana.xyz/mirror/mostlygeek/llama-swap",
        "harbor.rcrumana.xyz/mirror/lklynet/hypermind",
        "harbor.rcrumana.xyz/mirror/library/nextcloud",
        "harbor.rcrumana.xyz/proxy-ghcr/berriai/litellm"
      ],
      "enabled": false
    },
    {
      "description": "Never update only the CNPG image override without replacing its vendored manifest",
      "matchDatasources": ["docker"],
      "matchFileNames": ["cluster/platform/base/data/data-operators/postgres-operator/kustomization.yaml"],
      "enabled": false
    },
    {
      "description": "Never update only the snapshot-controller image without replacing its vendored release bundle",
      "matchDatasources": ["docker"],
      "matchFileNames": ["cluster/platform/base/kube-system/snapshot-controller/deployment-patch.yaml"],
      "enabled": false
    },
    {
      "description": "Resolve the Harbor GHCR proxy against upstream GHCR",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.rcrumana.xyz/proxy-ghcr/**"],
      "overridePackageName": "{{replace 'harbor.rcrumana.xyz/proxy-ghcr/' 'ghcr.io/' packageName}}",
      "registryUrls": ["https://ghcr.io"]
    },
    {
      "description": "Resolve the Harbor Docker Hub proxy against upstream Docker Hub",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.rcrumana.xyz/proxy-dockerhub/**"],
      "overridePackageName": "{{replace 'harbor.rcrumana.xyz/proxy-dockerhub/' 'docker.io/' packageName}}",
      "registryUrls": ["https://index.docker.io"]
    },
    {
      "description": "Pin Uptime Kuma's mutable rootless channel to an immutable digest",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.rcrumana.xyz/proxy-dockerhub/louislam/uptime-kuma"],
      "pinDigests": true
    },
    {
      "description": "Upstream mapping: harbor.rcrumana.xyz/mirror/linuxserver/ -> lscr.io/linuxserver/",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.rcrumana.xyz/mirror/linuxserver/**"],
      "overridePackageName": "{{replace 'harbor.rcrumana.xyz/mirror/linuxserver/' 'lscr.io/linuxserver/' packageName}}",
      "registryUrls": ["https://lscr.io"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?[^-]*(?:-(?:[^-]+-)?ls(?<revision>\\d+))?$"
    },
    {
      "description": "Upstream mapping: harbor.rcrumana.xyz/mirror/cloudnative-pg/ -> ghcr.io/cloudnative-pg/",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["harbor.rcrumana.xyz/mirror/cloudnative-pg/**"],
